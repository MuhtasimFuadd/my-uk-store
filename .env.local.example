# Copy this file to .env.local and fill in your own values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase: Project Settings -> API -> "service_role" key.
# NEVER put NEXT_PUBLIC_ in front of this one — it must stay server-only.
# It's what lets the admin panel write to the database, bypassing the
# public read-only policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The password you'll type in at /admin/login to manage products.
# Also server-only — never prefix this with NEXT_PUBLIC_.
ADMIN_PASSWORD=choose-a-strong-password

# Without the two NEXT_PUBLIC_SUPABASE_ variables set, the site falls back
# to sample product data automatically, so it always runs even before you
# connect a database. The admin panel needs all four variables set to work.

# Resend: resend.com -> API Keys -> Create API Key.
# Server-only. Used to send the order confirmation email after checkout.
# If left blank, checkout still works fine — the email is just skipped
# (logged as a warning), so this isn't required to test the rest of the site.
RESEND_API_KEY=your-resend-api-key

# Google sign-in itself needs NO new env vars here — that configuration
# lives entirely in the Supabase dashboard (Authentication -> Providers ->
# Google), not in this file. See README.md for the setup steps.
