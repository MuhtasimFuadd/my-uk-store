# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in Supabase: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Without these two set, the site falls back to sample product data
# automatically, so it always runs even before you connect a database.
